generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PREMIUM
  LIFETIME
}

enum Privacy {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum MediaType {
  PHOTO
  VIDEO
  MUSIC
  COVER
}

enum InviteRole {
  EDITOR
  VIEWER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("CLIENT")
  stripeCustomerId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  memorials     Memorial[] @relation("MemorialOwner")
  tributes      Tribute[]
  invitesSent   MemorialInvite[] @relation("InviteSender")
  invitesRecv   MemorialInvite[] @relation("InviteReceiver")
  memberships   MemorialMember[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Memorial {
  id              String   @id @default(cuid())
  slug            String   @unique
  firstName       String
  lastName        String
  birthDate       DateTime?
  deathDate       DateTime?
  biography       String?
  serviceInfo     String?
  coverImageUrl   String?
  theme           String   @default("serene")
  privacy         Privacy  @default(PUBLIC)
  accessPassword  String?
  plan            Plan     @default(FREE)
  featured        Boolean  @default(false)
  stripeSubId     String?
  stripePriceId   String?
  ownerId         String
  owner           User     @relation("MemorialOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  media           MemorialMedia[]
  tributes        Tribute[]
  invites         MemorialInvite[]
  members         MemorialMember[]
}

model MemorialMedia {
  id         String    @id @default(cuid())
  memorialId String
  memorial   Memorial  @relation(fields: [memorialId], references: [id], onDelete: Cascade)
  type       MediaType
  url        String
  caption    String?
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
}

model Tribute {
  id         String   @id @default(cuid())
  memorialId String
  memorial   Memorial @relation(fields: [memorialId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  body       String
  createdAt  DateTime @default(now())
}

model MemorialInvite {
  id         String       @id @default(cuid())
  memorialId String
  memorial   Memorial     @relation(fields: [memorialId], references: [id], onDelete: Cascade)
  email      String
  role       InviteRole   @default(EDITOR)
  status     InviteStatus @default(PENDING)
  token      String       @unique @default(cuid())
  senderId   String
  sender     User         @relation("InviteSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String?
  receiver   User?        @relation("InviteReceiver", fields: [receiverId], references: [id], onDelete: SetNull)
  createdAt  DateTime     @default(now())
}

model MemorialMember {
  id         String     @id @default(cuid())
  memorialId String
  memorial   Memorial   @relation(fields: [memorialId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       InviteRole @default(EDITOR)
  createdAt  DateTime   @default(now())

  @@unique([memorialId, userId])
}
